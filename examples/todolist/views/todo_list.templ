package views

import "core:fmt"

// Page data
Todo_Page :: struct {
    todos:       []Todo,
    filter:      Filter,
    theme_color: string,
}

// Main todo list page - demonstrates:
// - Layout composition with slots
// - For loops
// - Switch statements
// - If/else conditionals
// - Component calls
// - Style blocks with {{ expr }}
// - Raw HTML output
todo_list_page :: templ(data: Todo_Page) {
    @layout("Todo List - Tempo Example") {
        // Head slot - custom styles with dynamic theme
        #head {
            <style>
                :root {
                    --primary-color: {{ data.theme_color }};
                    --completed-color: #888;
                }

                * { box-sizing: border-box; margin: 0; padding: 0; }

                body {
                    font-family: system-ui, -apple-system, sans-serif;
                    background: #f5f5f5;
                    color: #333;
                    line-height: 1.6;
                }

                .container {
                    max-width: 600px;
                    margin: 2rem auto;
                    padding: 0 1rem;
                }

                h1 {
                    color: var(--primary-color);
                    text-align: center;
                    margin-bottom: 1.5rem;
                }

                .filters {
                    display: flex;
                    gap: 0.5rem;
                    justify-content: center;
                    margin-bottom: 1rem;
                }

                .filter-btn {
                    padding: 0.5rem 1rem;
                    border: 2px solid var(--primary-color);
                    background: white;
                    color: var(--primary-color);
                    border-radius: 4px;
                    cursor: pointer;
                }

                .filter-btn.active {
                    background: var(--primary-color);
                    color: white;
                }

                .todo-list {
                    list-style: none;
                    background: white;
                    border-radius: 8px;
                    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
                }

                .todo-item {
                    display: flex;
                    align-items: center;
                    gap: 0.75rem;
                    padding: 1rem;
                    border-bottom: 1px solid #eee;
                }

                .todo-item:last-child { border-bottom: none; }

                .todo-item.completed .todo-text {
                    text-decoration: line-through;
                    color: var(--completed-color);
                }

                .todo-item.priority-high {
                    border-left: 4px solid #e74c3c;
                }

                .todo-checkbox {
                    width: 1.25rem;
                    height: 1.25rem;
                    accent-color: var(--primary-color);
                }

                .todo-text { flex: 1; }

                .badge {
                    font-size: 0.75rem;
                    padding: 0.125rem 0.5rem;
                    border-radius: 999px;
                }

                .badge-low { background: #dfe6e9; color: #636e72; }
                .badge-high { background: #fab1a0; color: #d63031; }
                .badge-urgent { background: #d63031; color: white; }

                .btn-delete {
                    padding: 0.25rem 0.5rem;
                    border: 1px solid #ddd;
                    background: white;
                    border-radius: 4px;
                    cursor: pointer;
                }

                .btn-delete:disabled {
                    opacity: 0.5;
                    cursor: not-allowed;
                }

                .stats {
                    text-align: center;
                    margin-top: 1rem;
                    color: #666;
                    font-size: 0.875rem;
                }

                .empty-state {
                    text-align: center;
                    padding: 3rem;
                    color: #999;
                }
            </style>
        }

        <h1>Todo List</h1>

        // Filter tabs - demonstrates switch statement
        <div class="filters">
            switch data.filter {
            case .All:
                <button class="filter-btn active">All</button>
                <button class="filter-btn">Active</button>
                <button class="filter-btn">Completed</button>
            case .Active:
                <button class="filter-btn">All</button>
                <button class="filter-btn active">Active</button>
                <button class="filter-btn">Completed</button>
            case .Completed:
                <button class="filter-btn">All</button>
                <button class="filter-btn">Active</button>
                <button class="filter-btn active">Completed</button>
            }
        </div>

        // Todo list with conditional empty state
        if len(data.todos) == 0 {
            <div class="empty-state">
                <p>No todos yet!</p>
                <p>Add some tasks to get started.</p>
            </div>
        } else {
            <ul class="todo-list">
                // For loop over todos - calls todo_item component
                for todo in data.todos {
                    @todo_item(todo)
                }
            </ul>

            // Stats footer
            {{ stats := calc_stats(data.todos) }}
            <div class="stats">
                { fmt.tprintf("%d total", stats.total) } |
                { fmt.tprintf("%d active", stats.active) } |
                { fmt.tprintf("%d completed", stats.completed) }
            </div>
        }

        // Scripts slot - uses script component
        #scripts {
            // Emit the CSS from css components
            <style>
                {{ highlight_box_css }}
            </style>

            // Emit the JS from script components
            <script>
                {{ init_app_js }}
                /* Initialize on load */
                document.addEventListener('DOMContentLoaded', init_app);
            </script>
        }
    }
}
